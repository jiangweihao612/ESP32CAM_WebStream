page {
    min-height: 100%;
    background: #f2f4f7;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-size: 28rpx;
}

button {
    border-radius: 12rpx;
}

.card {
    background: #ffffff;
    border-radius: 20rpx;
    padding: 28rpx;
    margin: 0 24rpx 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.card-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
    margin-bottom: 20rpx;
}

.muted {
    color: #8a9099;
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hint {
    font-size: 24rpx;
    color: #8a9099;
    line-height: 1.6;
}
