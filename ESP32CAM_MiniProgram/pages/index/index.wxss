.page {
    padding: 20rpx 0 40rpx;
}

/* ---------- 设备地址栏 ---------- */
.devbar {
    display: flex;
    align-items: center;
    background: #ffffff;
    margin: 0 24rpx 20rpx;
    padding: 0 24rpx;
    height: 88rpx;
    border-radius: 18rpx;
    box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.dev-dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    margin-right: 16rpx;
    flex-shrink: 0;
}

.dev-dot.on {
    background: #22c55e;
    box-shadow: 0 0 0 6rpx rgba(34, 197, 94, 0.16);
}

.dev-dot.off {
    background: #c9ced6;
}

.dev-input {
    flex: 1;
    font-size: 28rpx;
    color: #1f2329;
    height: 88rpx;
}

.dev-ph {
    color: #b6bcc6;
    font-size: 26rpx;
}

.dev-state {
    font-size: 24rpx;
    color: #8a9099;
    margin-left: 16rpx;
    flex-shrink: 0;
}

/* ---------- 画面区 ---------- */
.stage {
    position: relative;
    margin: 0 24rpx 24rpx;
    height: 500rpx;
    border-radius: 20rpx;
    overflow: hidden;
    background: #10141a;
}

.frame {
    width: 100%;
    height: 500rpx;
    display: block;
}

.stage-mask {
    height: 500rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* 遮罩盖在画面之上，图片元素保持挂载才能持续重试取帧 */
.stage-mask.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    background: #10141a;
}

.mask-title {
    color: #ffffff;
    font-size: 30rpx;
    font-weight: 600;
    margin-bottom: 12rpx;
}

.mask-sub {
    color: #8c95a3;
    font-size: 24rpx;
    line-height: 1.9;
}

.mask-tip {
    color: #5d6572;
    font-size: 22rpx;
    margin-top: 8rpx;
}

.mask-ip {
    color: #5d6572;
    font-family: monospace;
}

.mask-err {
    color: #ff8a8a;
    margin-top: 12rpx;
    max-width: 520rpx;
    text-align: center;
    word-break: break-all;
}

.mask-btn {
    margin-top: 28rpx;
    background: #2f6bff;
    color: #ffffff;
    font-size: 26rpx;
    padding: 0 40rpx;
    height: 64rpx;
    line-height: 64rpx;
    border-radius: 32rpx;
}

.mask-actions {
    display: flex;
    align-items: center;
    margin-top: 28rpx;
}

.mask-actions .mask-btn {
    margin-top: 0;
    margin-right: 20rpx;
}

.mask-actions .mask-btn:last-child {
    margin-right: 0;
}

.mask-btn.ghost {
    background: transparent;
    color: #8c95a3;
    border: 1rpx solid #2c333d;
}

.mask-btn::after {
    border: none;
}

.live-badge {
    position: absolute;
    left: 20rpx;
    top: 20rpx;
    display: flex;
    align-items: center;
    background: rgba(16, 20, 26, 0.62);
    padding: 6rpx 16rpx;
    border-radius: 999rpx;
}

.live-badge text {
    color: #ffffff;
    font-size: 22rpx;
}

.live-dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 50%;
    background: #22c55e;
    margin-right: 10rpx;
}

.rec-badge {
    display: flex;
    align-items: center;
    margin-top: 20rpx;
    background: rgba(255, 77, 79, 0.16);
    padding: 6rpx 18rpx;
    border-radius: 999rpx;
}

.rec-badge text {
    color: #ff7875;
    font-size: 22rpx;
}

.rec-dot {
    width: 12rpx;
    height: 12rpx;
    border-radius: 50%;
    background: #ff4d4f;
    margin-right: 10rpx;
    animation: blink 1.1s infinite;
}

.rec-dot.big {
    width: 20rpx;
    height: 20rpx;
    margin-right: 0;
    margin-bottom: 16rpx;
}

@keyframes blink {
    0%,
    100% {
        opacity: 1;
    }
    50% {
        opacity: 0.25;
    }
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 4rpx solid rgba(255, 255, 255, 0.18);
    border-top-color: #2f6bff;
    border-radius: 50%;
    margin-bottom: 18rpx;
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* ---------- 操作区 ---------- */
.actions {
    display: flex;
    background: #ffffff;
    margin: 0 24rpx 24rpx;
    border-radius: 20rpx;
    padding: 8rpx;
    box-shadow: 0 2rpx 12rpx rgba(31, 35, 41, 0.04);
}

.action {
    flex: 1;
    padding: 22rpx 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-radius: 16rpx;
}

.action + .action {
    border-left: 1rpx solid #f0f2f5;
}

.action-hover {
    background: #f7f9fc;
}

.action.primary .action-title {
    color: #2f6bff;
}

.action.danger .action-title {
    color: #ff4d4f;
}

.action-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2329;
}

.action-sub {
    font-size: 22rpx;
    color: #9aa1ac;
    margin-top: 6rpx;
}

/* ---------- 卡片内通用 ---------- */
.card-title.inline {
    margin-bottom: 0;
}

.picker {
    min-width: 160rpx;
    text-align: center;
    font-size: 26rpx;
    color: #2f6bff;
    background: #eef3ff;
    padding: 10rpx 22rpx;
    border-radius: 999rpx;
}

.picker.disabled {
    color: #b6bcc6;
    background: #f3f5f8;
}

.hint {
    display: block;
    margin-top: 16rpx;
}

.kv {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16rpx 0;
    border-bottom: 1rpx solid #f4f6f9;
}

.kv:last-child {
    border-bottom: none;
    padding-bottom: 0;
}

.k {
    font-size: 26rpx;
    color: #8a9099;
}

.v {
    font-size: 26rpx;
    color: #1f2329;
    max-width: 420rpx;
    text-align: right;
}

.foot-tip {
    padding: 0 32rpx;
}
